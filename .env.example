# Copy this file to .env.local (in this frontend/ folder) and fill in real
# values. Next.js only reads .env.local from its own project root, so this
# file must live here, not at the repo root. Same Supabase project as backend/.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional — set to the backend's absolute URL if it's ever hosted separately
# from this app (e.g. in production). Falls back to the relative '/api', which
# next.config.js rewrites to the backend in local dev.
NEXT_PUBLIC_API_URL=
